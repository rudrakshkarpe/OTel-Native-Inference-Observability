{
  "kind": "Dashboard",
  "metadata": {
    "name": "llm-inference-overview",
    "project": "default"
  },
  "spec": {
    "display": {
      "name": "LLM Inference Overview",
      "description": "vLLM serving latency, token throughput, KV-cache pressure and GPU fleet health. Works unchanged against the simulator (demo mode) or real vLLM + DCGM (GPU mode)."
    },
    "duration": "30m",
    "refreshInterval": "30s",
    "panels": {
      "ttft": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Time to First Token (P50 / P95 / P99)",
            "description": "Queue wait + prefill + first decode step. The primary user-facing latency SLI for streaming workloads."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "seconds" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "seriesNameFormat": "p50" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "seriesNameFormat": "p95" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "seriesNameFormat": "p99" } } } }
          ]
        }
      },
      "itl": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Inter-Token Latency (P50 / P95)",
            "description": "Per-output-token decode latency (TPOT). Degrades as the decode batch grows."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "seconds" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.50, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "seriesNameFormat": "p50" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "seriesNameFormat": "p95" } } } }
          ]
        }
      },
      "throughput": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Token Throughput",
            "description": "Prefill vs. generation tokens per second across all requests."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "decimal" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(rate(vllm:prompt_tokens_total[5m]))", "seriesNameFormat": "prompt tok/s" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(rate(vllm:generation_tokens_total[5m]))", "seriesNameFormat": "generation tok/s" } } } }
          ]
        }
      },
      "scheduler": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Scheduler State",
            "description": "Running batch vs. waiting queue. A growing queue is the leading indicator of TTFT degradation."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": {} },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(vllm:num_requests_running)", "seriesNameFormat": "running" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(vllm:num_requests_waiting)", "seriesNameFormat": "waiting" } } } }
          ]
        }
      },
      "queueTime": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue Time P95",
            "description": "Time requests spend waiting before admission to the decode batch."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "seconds" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket[5m])))", "seriesNameFormat": "p95 queue time" } } } }
          ]
        }
      },
      "kvCache": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "KV-Cache Usage",
            "description": "Fraction of KV-cache blocks in use. Sustained >90% forces preemption and recomputation."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "percent-decimal" }, "max": 1 } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "max(vllm:kv_cache_usage_perc)", "seriesNameFormat": "kv-cache usage" } } } }
          ]
        }
      },
      "prefixCache": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Prefix Cache Hit Rate",
            "description": "Share of queried prompt tokens served from the prefix cache."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "percent-decimal" }, "max": 1 } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(rate(vllm:prefix_cache_hits_total[5m])) / sum(rate(vllm:prefix_cache_queries_total[5m]))", "seriesNameFormat": "hit rate" } } } }
          ]
        }
      },
      "gpuUtil": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Utilization",
            "description": "Per-GPU compute utilization from DCGM."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "percent" }, "max": 100 } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "DCGM_FI_DEV_GPU_UTIL", "seriesNameFormat": "gpu {{gpu}}" } } } }
          ]
        }
      },
      "gpuMemory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Memory (Framebuffer Used)",
            "description": "Model weights + KV-cache allocation per GPU, in MiB."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "decimal" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "DCGM_FI_DEV_FB_USED", "seriesNameFormat": "gpu {{gpu}} used MiB" } } } }
          ]
        }
      },
      "gpuPowerTemp": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Power & Temperature",
            "description": "Power draw (W) and temperature (°C) per GPU."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": {} },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "DCGM_FI_DEV_POWER_USAGE", "seriesNameFormat": "gpu {{gpu}} watts" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "DCGM_FI_DEV_GPU_TEMP", "seriesNameFormat": "gpu {{gpu}} °C" } } } }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": { "title": "Inference Engine (vLLM)", "collapse": { "open": true } },
          "items": [
            { "x": 0, "y": 0, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/ttft" } },
            { "x": 12, "y": 0, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/itl" } },
            { "x": 0, "y": 8, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/throughput" } },
            { "x": 8, "y": 8, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/scheduler" } },
            { "x": 16, "y": 8, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/queueTime" } },
            { "x": 0, "y": 16, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/kvCache" } },
            { "x": 12, "y": 16, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/prefixCache" } }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": { "title": "GPU Fleet (DCGM)", "collapse": { "open": true } },
          "items": [
            { "x": 0, "y": 0, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/gpuUtil" } },
            { "x": 8, "y": 0, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/gpuMemory" } },
            { "x": 16, "y": 0, "width": 8, "height": 8, "content": { "$ref": "#/spec/panels/gpuPowerTemp" } }
          ]
        }
      }
    ]
  }
}
