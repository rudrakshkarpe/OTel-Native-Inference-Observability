              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/token-rate"
              }
            },
            {
              "x": 0,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/outcomes"
              }
            },
            {
              "x": 12,
              "y": 7,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/token-count"
              }
            }
          ]
        }
      }
    ]
  }
}
