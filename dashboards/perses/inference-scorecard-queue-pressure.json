              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.outcome_count\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
