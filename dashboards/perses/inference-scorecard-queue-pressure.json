            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.completed_output_tokens_per_second\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "output tokens/s"
                  }
                }
              }
            }
          ]
        }
      },
      "outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request outcomes and missing usage",
            "description": "Whole-scenario totals and wall-time rates for queue-pressure. Scale: 0 to 40."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "max": 40,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
          },
          "queries": [
