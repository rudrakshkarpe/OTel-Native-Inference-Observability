        "spec": {
          "display": {
            "name": "Scenario throughput: tokens/s",
            "description": "Whole-scenario totals and wall-time rates for queue-pressure. Scale: 0 to 200."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "max": 200,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
