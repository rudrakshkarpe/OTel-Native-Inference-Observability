                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "queue": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Native queue wait",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 30s."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
