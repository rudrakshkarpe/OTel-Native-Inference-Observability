            {
              "x": 12,
              "y": 14,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/decode"
              }
            },
            {
              "x": 0,
              "y": 21,
              "width": 12,
              "height": 7,
              "content": {
                "$ref": "#/spec/panels/request_mean_itl"
              }
