          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.prefill\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "decode": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Native decode",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 20s."
