      "request_mean_itl": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Per-request mean ITL",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 0.05s."
          },
          "plugin": {
