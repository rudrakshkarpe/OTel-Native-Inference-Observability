                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.request_mean_itl\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "request_output_tps": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Per-request engine output tokens/s",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 50."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "max": 50,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.request_output_tps\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "request-rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Scenario throughput: requests/s",
            "description": "Whole-scenario totals and wall-time rates for queue-pressure. Scale: 0 to 0.6."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "max": 0.6000000000000001,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.attempted_requests_per_second\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "attempted requests/s"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.completed_requests_per_second\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "completed requests/s"
                  }
                }
              }
            }
          ]
        }
      },
      "token-rate": {
