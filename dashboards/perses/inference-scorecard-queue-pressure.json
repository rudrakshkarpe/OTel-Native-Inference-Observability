{
  "kind": "Dashboard",
  "metadata": {
    "name": "inference-scorecard-queue-pressure",
    "project": "default"
  },
  "spec": {
    "display": {
      "name": "Dash0 inference scorecard: queue-pressure",
      "description": "Exact fixed-capture statistics, replay dash0-h100-20260927. Completed-request percentiles and scenario wall-time throughput. Select the replay window; no live GPU is running."
    },
    "duration": "1h",
    "panels": {
      "client_first_content": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Client first-content latency",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 30s."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "max": 30,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.client_first_content\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "client_duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Client request duration",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 40s."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "max": 40,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "max_over_time({otel_metric_name=\"inference_lab.summary.client_duration\",inference_replay_id=\"dash0-h100-20260927\",inference_summary_id=\"inference-scorecard-v1\",inference_scenario=\"queue-pressure\"}[15s])",
                    "seriesNameFormat": "p{{percentile}} / n={{sample_count}}"
                  }
                }
              }
            }
          ]
        }
      },
      "engine_ttft": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Native engine TTFT",
            "description": "Completed requests: nearest-rank percentiles for queue-pressure. Scale: 0 to 30s."
          },
          "plugin": {
            "kind": "GaugeChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "max": 30,
              "visual": {
                "palette": {
                  "mode": "categorical"
                }
              },
              "dash0Extensions": {
                "maxTimeSeries": 4,
                "displayMode": "normal",
                "hideSeriesName": false
              }
            }
