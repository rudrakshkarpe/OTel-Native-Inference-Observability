{
  "kind": "Dashboard",
  "metadata": {
    "name": "llm-inference-saturation",
    "project": "default"
  },
  "spec": {
    "display": {
      "name": "LLM Inference Saturation Incident",
      "description": "Causal chain for the demo saturation burst: queue growth, KV-cache pressure, TTFT P99, and request success rate. Pair with gen_ai.* spans for the 429 pivot."
    },
    "duration": "30m",
    "refreshInterval": "15s",
    "panels": {
      "waiting": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Waiting Queue Depth",
            "description": "Leading indicator. Climbs first when arrivals outpace the decode batch."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": {} },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(vllm:num_requests_waiting)", "seriesNameFormat": "waiting" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(vllm:num_requests_running)", "seriesNameFormat": "running" } } } }
          ]
        }
      },
      "kv": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "KV-Cache Pressure",
            "description": "Sustained >0.9 forces preemption. During the burst this approaches ~0.95."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "percent-decimal" }, "max": 1 } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "max(vllm:kv_cache_usage_perc)", "seriesNameFormat": "kv-cache usage" } } } }
          ]
        }
      },
      "ttftP99": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "TTFT P99",
            "description": "User-facing SLI. Spikes with queue time during saturation."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "seconds" } } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[2m])))", "seriesNameFormat": "p99 TTFT" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_queue_time_seconds_bucket[2m])))", "seriesNameFormat": "p95 queue" } } } }
          ]
        }
      },
      "successRate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Successful Completions",
            "description": "Completions by finish reason. Pair with gen_ai spans where http.response.status_code=429 during the burst."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": {} },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum(rate(vllm:request_success_total[2m]))", "seriesNameFormat": "success/s" } } } },
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "sum by (finished_reason) (rate(vllm:request_success_total[2m]))", "seriesNameFormat": "{{finished_reason}}" } } } }
          ]
        }
      },
      "gpuUtil": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Util During Incident",
            "description": "Often still looks fine while the queue and KV-cache tell the real story."
          },
          "plugin": { "kind": "TimeSeriesChart", "spec": { "yAxis": { "format": { "unit": "percent" }, "max": 100 } } },
          "queries": [
            { "kind": "TimeSeriesQuery", "spec": { "plugin": { "kind": "PrometheusTimeSeriesQuery", "spec": { "query": "DCGM_FI_DEV_GPU_UTIL", "seriesNameFormat": "gpu {{gpu}}" } } } }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": { "title": "Saturation causal chain", "collapse": { "open": true } },
          "items": [
            { "x": 0, "y": 0, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/waiting" } },
            { "x": 12, "y": 0, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/kv" } },
            { "x": 0, "y": 8, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/ttftP99" } },
            { "x": 12, "y": 8, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/successRate" } },
            { "x": 0, "y": 16, "width": 24, "height": 8, "content": { "$ref": "#/spec/panels/gpuUtil" } }
          ]
        }
      }
    ]
  }
}
