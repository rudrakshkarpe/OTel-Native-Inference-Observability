# --- Dash0 connection ------------------------------------------------------
# Copy this file to .env and fill in YOUR values from app.dash0.com:
#   Endpoint:   Settings -> Endpoints -> OTLP via gRPC (starts with "ingress.", ends with ":4317")
#   Auth token: Settings -> Auth Tokens (paste the raw token, WITHOUT the "Bearer " prefix)
# The endpoint is region- AND cloud-specific. Examples:
#   AWS:  ingress.eu-west-1.aws.dash0.com:4317  /  ingress.us-west-2.aws.dash0.com:4317
#   GCP:  ingress.europe-west4.gcp.dash0.com:4317
# Copy the exact one shown in your org settings — a wrong region/cloud returns
# "Unauthenticated" even when the token is correct.
DASH0_ENDPOINT=ingress.europe-west4.gcp.dash0.com:4317
DASH0_AUTH_TOKEN=
# Optional: route this demo into a dedicated dataset (defaults to "default")
DASH0_DATASET=default

# --- Scrape targets (demo mode defaults; overridden by docker-compose.gpu.yml)
VLLM_METRICS_TARGET=simulator:8000
DCGM_METRICS_TARGET=simulator:9400
